SECRET_KEY=8KjP2mNx7vL9qR4t
SUBNET=172.20.0.0/24
DOMAIN=mail.innerinfo.com
HOSTNAMES=mail.innerinfo.com,innerinfo.com
POSTMASTER=admin
TLS_FLAVOR=cert  # cert로 변경 (수동 인증서 사용)
AUTH_RATELIMIT_IP=5/hour
AUTH_RATELIMIT_USER=50/day
